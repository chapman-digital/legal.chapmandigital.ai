---
import { getCollection, render } from "astro:content";
import Base from "../layouts/Base.astro";

export async function getStaticPaths() {
  const entries = await getCollection("docs");
  return entries.map((entry) => ({ params: { doc: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Base title={entry.data.title} description={entry.data.description}>
  <section slot="hero" class="hero hero--doc">
    <div class="container">
      <p class="eyebrow"><a href="/">CD-AI Legal</a> / {entry.data.title}</p>
      <h1>{entry.data.title}</h1>
      <p class="hero__lead">{entry.data.updated}</p>
    </div>
  </section>
  <div class="container section">
    <article class="prose">
      <Content />
    </article>
  </div>
</Base>
